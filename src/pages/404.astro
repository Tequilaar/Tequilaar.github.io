---
import Base from '~/layouts/Base.astro'
import { ui } from '~/i18n'
---

<Base lang="zh" title="404">
  <section class="container">
    <h1>404</h1>
    <p>{ui.zh.notFound} · {ui.en.notFound} · {ui.de.notFound}</p>
    <a href="/">← {ui.zh.backHome}</a>
  </section>
</Base>

<style>
  section {
    padding-top: 96px;
  }

  h1 {
    font-size: 4rem;
    margin: 0;
    letter-spacing: -0.03em;
  }

  p {
    color: var(--muted);
  }

  a {
    color: var(--accent-text);
  }
</style>
